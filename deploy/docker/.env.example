# Optional overrides. Docker Compose already uses these demo defaults when no
# .env file exists, so copying this file is NOT required for the quick start.
# These credentials are intentionally public and suitable only for the
# loopback-only local demo.

POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=orapglink-demo-admin
ORAPGLINK_RUNTIME_PASSWORD=orapglink-demo-runtime
ORAPGLINK_INSTALL_PASSWORD=orapglink-demo-install
ORAPGLINK_ORACLE_PASSWORD=orapglink-demo-oracle
ORAPGLINK_LOGICAL_SCHEMA=PUBLIC

# Host ports. Both bind to loopback in docker-compose.yml.
ORAPGLINK_DEMO_TNS_PORT=1521
ORAPGLINK_DEMO_PG_PORT=55432

# Optional published images. Leave commented to build from this checkout.
#ORAPGLINK_POSTGRES_IMAGE=ghcr.io/krokozyab/orapglink-postgres-demo:pg16
#ORAPGLINK_IMAGE=ghcr.io/krokozyab/orapglink:latest
